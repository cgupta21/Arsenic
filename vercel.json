{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm ci --include=dev",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/((?!api|auth|assets|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}