{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm ci --include=dev",
  "rewrites": [
    {
      "source": "/auth/github/callback",
      "destination": "/api/auth/github/callback"
    },
    {
      "source": "/auth/github",
      "destination": "/api/auth/github"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/auth/logout"
    },
    {
      "source": "/u/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|twitterbot|whatsapp|telegram|slackbot|discordbot|linkedinbot|embedly|quora|pinterest).*"
        }
      ],
      "destination": "/api/meta/:username"
    },
    {
      "source": "/((?!api|auth|assets|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}